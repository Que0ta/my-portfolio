      <img src="/images/arrow.svg" alt="">
      <div class="list-inside">
        <span class="lead">Web development</span>
        <ul class="text_lead list-items">
          <li>Adaptive layouts</li>
          <li>Individual designs</li>
          <li>Support after deployment</li>
          <li>Basic SEO skills</li>
        </ul>
      </div>
    </div>
  </div>
  
  <div class="stats">
    <span class="lead">Levels of tech skills</span>
    <div class="skills">
      
      <div class="skill-item">
        <div class="skill-item-text">
          <h3>HTML</h3>
          <span class="number"> 90% </span>
        </div>
