<%- include("partials/header.ejs") %>
<div class="about">
  <span class="lead">About me</span>
  <p class="text_lead">
    I’m an active person that likes to do skiing. I'm sociable and
    easy-going. Always ready to take action when there is an opportunity.
  </p>
</div>

<div class="services">
    <span class="lead">Services</span>
