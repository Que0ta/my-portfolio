      </div>

      <div class="skill-item">
        <div class="skill-item-text">
          <h3>JS</h3>
          <span class="number"> 60% </span>
        </div>
        <progress class="percento" value="60" max="100"></progress>
      </div>

      <div class="skill-item">
        <div class="skill-item-text">
          <h3>Figma</h3>
          <span class="number"> 60% </span>
        </div>
        <progress class="percento" value="60" max="100"></progress>
      </div>

      <div class="skill-item">
